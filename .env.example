# ==============================================================================
# DIGITAL HUB — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development (`npm run dev`), or to
# `.dev.vars` for local Cloudflare Workers preview (`npx wrangler dev`).
# For production on Cloudflare Workers, configure Build Variables & Worker
# Secrets inside the Cloudflare Dashboard (Workers & Pages -> digital-hub ->
# Settings -> Variables and Secrets).
#
# NEVER commit `.env`, `.dev.vars`, or real private secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUDFLARE WORKERS BUILD VARIABLES (Set in Cloudflare Builds -> Variables)
# ------------------------------------------------------------------------------
# Pins Bun version to match `bun.lock` (lockfileVersion: 2) and `package.json`.
BUN_VERSION="1.4.4"

# ------------------------------------------------------------------------------
# 2. OPTIONAL FRONTEND VARIABLES (Vite Build-Time — PUBLIC IN BROWSER BUNDLE)
#    Only `VITE_*` variables are exposed to client code. NEVER put secrets here!
# ------------------------------------------------------------------------------
# Leave BLANK for unified Cloudflare Workers with Static Assets (recommended) or
# same-origin Node.js (`server.ts`), where the SPA and `/api/*` share one domain.
# Set ONLY when building the Android APK or hosting the SPA separately from `/api/*`.
VITE_API_BASE_URL=""

# OPTIONAL Firebase Web SDK overrides (PUBLIC client config — NOT secrets).
# Leave as placeholders or omit them to continue using `firebase-applet-config.json`
# automatically without any changes to your current Firebase project.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"
VITE_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 3. SERVER / CLOUDFLARE WORKER SECRETS & RUNTIME VARIABLES (KEEP PRIVATE!)
#    Set these as encrypted Secrets / Runtime Variables in Cloudflare Workers
#    (Workers & Pages -> digital-hub -> Settings -> Variables and Secrets),
#    or via CLI: `npx wrangler secret put <VARIABLE_NAME>`
#    Do NOT put private secrets into `VITE_*` variables or `wrangler.jsonc`.
# ------------------------------------------------------------------------------
# Local / Node.js server (`server.ts`) runtime settings (not required on Workers):
NODE_ENV="production"
PORT="3000"

# Public URL of your deployed Cloudflare Worker / custom domain (no trailing slash).
# Example: https://digital-hub.<your-subdomain>.workers.dev
APP_URL="https://YOUR_CLOUDFLARE_DOMAIN"

# Optional comma-separated list of additional origins allowed to call `/api/*` via CORS
# (e.g. your custom domain or staging preview URL; same-origin requests always work).
ALLOWED_CORS_ORIGINS="https://YOUR_CLOUDFLARE_DOMAIN"

# Optional Super Admin email override verified server-side on `/api/admin/*`.
# Must be a verified Google account email; must also match Firestore rules if changed.
SUPER_ADMIN_EMAIL="YOUR_SUPER_ADMIN_EMAIL"

# Optional server-side Firebase project/database overrides (defaults to `firebase-applet-config.json`).
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""

# Watch & Earn Server-to-Server (S2S) Postback Verification Secrets (ENCRYPTED SECRETS!)
# Generate long random values (e.g., `openssl rand -hex 32`) and configure the same
# secret in your ad network's S2S postback settings.
WATCH_EARN_S2S_SECRET="YOUR_WATCH_EARN_S2S_SECRET"
AD_POSTBACK_SECRET_AFDERS="YOUR_AFDERS_POSTBACK_SECRET"
AD_POSTBACK_SECRET_ARWF="YOUR_ARWF_POSTBACK_SECRET"
AD_POSTBACK_SECRET_BICEA="YOUR_BICEA_POSTBACK_SECRET"
AD_POSTBACK_SECRET_AUCTIONR="YOUR_AUCTIONR_POSTBACK_SECRET"
AD_POSTBACK_SECRET_ASIAFILM="YOUR_ASIAFILM_POSTBACK_SECRET"

# Optional server-side Gemini API key (reserved for future AI API routes; not currently used).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
