# ==============================================================================
# DIGITAL HUB — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` for local Node.js development (`npm run dev`), or to
# `.dev.vars` for local Cloudflare Workers preview (`npx wrangler dev`).
# For production on Cloudflare Workers, configure Secrets & Bindings inside
# Cloudflare Dashboard (Workers & Pages -> digital-hub -> Settings).
#
# NEVER commit `.env`, `.dev.vars`, or real private secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUDFLARE WORKERS BUILD VARIABLES
# ------------------------------------------------------------------------------
BUN_VERSION="1.4.4"

# ------------------------------------------------------------------------------
# 2. OPTIONAL FRONTEND VARIABLES (Vite Build-Time — PUBLIC IN BROWSER BUNDLE)
# ------------------------------------------------------------------------------
# Leave BLANK for unified Cloudflare Workers with Static Assets or same-origin
# Node.js (`server.ts`), where the SPA and `/api/*` share one domain.
VITE_API_BASE_URL=""

# ------------------------------------------------------------------------------
# 3. SERVER / CLOUDFLARE WORKER RUNTIME VARIABLES & SECRETS (KEEP PRIVATE!)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Public URL of your deployed Cloudflare Worker / custom domain (no trailing slash).
APP_URL="https://digital-hub.h20184249.workers.dev"

# Optional comma-separated list of additional origins allowed to call `/api/*`.
ALLOWED_CORS_ORIGINS="https://digital-hub.h20184249.workers.dev"

# Comma-separated Bangladesh mobile numbers (+8801XXXXXXXXX) granted Super Admin
# dashboard access on the server (set as a Cloudflare Worker Secret in production).
ADMIN_PHONE_NUMBERS=""

# Primary Super Admin email (verified strictly on server; auto-opens Admin Dashboard).
SUPER_ADMIN_EMAIL="ftake810@gmail.com"

# Optional comma-separated lowercase email addresses granted Admin
# dashboard access for email-registered accounts.
ADMIN_EMAILS=""

# Watch & Earn Server-to-Server (S2S) Postback Verification Secrets (optional).
WATCH_EARN_S2S_SECRET="YOUR_WATCH_EARN_S2S_SECRET"
AD_POSTBACK_SECRET_AFDERS="YOUR_AFDERS_POSTBACK_SECRET"
AD_POSTBACK_SECRET_ARWF="YOUR_ARWF_POSTBACK_SECRET"
AD_POSTBACK_SECRET_BICEA="YOUR_BICEA_POSTBACK_SECRET"
AD_POSTBACK_SECRET_AUCTIONR="YOUR_AUCTIONR_POSTBACK_SECRET"
AD_POSTBACK_SECRET_ASIAFILM="YOUR_ASIAFILM_POSTBACK_SECRET"
