# Server URL & CORS Allowlist
# APP_URL: The public URL where this applet is hosted (used for self-referential links, CORS, and API endpoints).
APP_URL="MY_APP_URL"
# ALLOWED_CORS_ORIGINS: Optional comma-separated list of permitted API origins.
ALLOWED_CORS_ORIGINS=""

# Super Admin Configuration (Server-Side)
# SUPER_ADMIN_EMAIL: Optional override for the bootstrapped Super Admin email address.
SUPER_ADMIN_EMAIL=""

# Watch & Earn Server-to-Server (S2S) Postback Secrets (KEEP PRIVATE — NEVER COMMIT REAL VALUES)
WATCH_EARN_S2S_SECRET=""
AD_POSTBACK_SECRET_AFDERS=""
AD_POSTBACK_SECRET_ARWF=""
AD_POSTBACK_SECRET_BICEA=""
AD_POSTBACK_SECRET_AUCTIONR=""
AD_POSTBACK_SECRET_ASIAFILM=""

# VITE_API_BASE_URL: Remote Express API origin used when running inside native Capacitor Android APK.
VITE_API_BASE_URL=""

# Optional Gemini API key (only if server-side AI features are enabled later)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
