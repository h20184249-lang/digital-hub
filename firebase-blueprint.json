        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderNumber", "customerId", "productId", "totalPriceBdt", "paymentMethod", "transactionId", "senderNumber", "status", "createdAt", "updatedAt"]
    },
