        "deliveryDurationEn": { "type": "string", "minLength": 1, "maxLength": 100 },
        "validityBn": { "type": "string", "maxLength": 200 },
        "validityEn": { "type": "string", "maxLength": 200 },
        "instructionsBn": { "type": "string", "maxLength": 1000 },
        "instructionsEn": { "type": "string", "maxLength": 1000 },
        "termsBn": { "type": "string", "maxLength": 1000 },
        "termsEn": { "type": "string", "maxLength": 1000 },
        "benefitsBn": { "type": "string", "maxLength": 1000 },
        "benefitsEn": { "type": "string", "maxLength": 1000 },
        "sectionTag": { "type": "string", "enum": ["flash_sale", "hot_product", "trending", "best_seller", "new_arrival", "standard"] },
        "imageUrl": { "type": "string", "maxLength": 200000 },
        "bannerUrl": { "type": "string", "maxLength": 200000 },
        "customLogoUrl": { "type": "string", "maxLength": 200000 },
        "featured": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "categoryId", "titleBn", "titleEn", "descriptionBn", "descriptionEn", "priceBdt", "availability", "deliveryDurationBn", "deliveryDurationEn", "imageUrl", "active", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer digital service order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
