        "discountBdt": { "type": "number" },
        "totalPriceBdt": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["bkash", "nagad", "rocket", "wallet"] },
        "transactionId": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderNumber": { "type": "string", "minLength": 4, "maxLength": 24 },
        "deliveryNote": { "type": "string", "maxLength": 1200 },
        "referenceAttachmentUrl": { "type": "string", "maxLength": 350000 },
