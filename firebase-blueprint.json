{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer account profile stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "phone": { "type": "string", "maxLength": 30 },
        "photoUrl": { "type": "string", "maxLength": 250000 },
        "referralCode": { "type": "string", "minLength": 4, "maxLength": 24, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referredBy": { "type": "string", "maxLength": 24 },
        "promotionalCredits": { "type": "number" },
        "language": { "type": "string", "enum": ["bn", "en"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "sessionRevokedAt": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "referralCode", "promotionalCredits", "status", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
