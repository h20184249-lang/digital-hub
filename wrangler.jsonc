{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digital-hub",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digital-hub-db",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "https://digital-hub.h20184249.workers.dev",
    "ALLOWED_CORS_ORIGINS": "https://digital-hub.h20184249.workers.dev"
  },
  "alias": {
    "iconv-lite": "./server/workerShims/iconvLite.ts"
  },
  "observability": {
    "enabled": true
  }
}
